# Copia a ".env" en esta misma carpeta y rellena valores reales.
# Docker Compose carga ".env" automáticamente para sustituir ${VAR} en compose.

# --- PostgreSQL (contenedor + Spring perfil docker) ---
POSTGRES_USER=sanos_app
POSTGRES_PASSWORD=example_replace_with_strong_password
POSTGRES_DB=sanos

# --- TEMPORAL: BD H2 ---
# DB_USERNAME=admin
# DB_PASSWORD=change-me-local

# --- Bases de datos (un bloque por servicio cuando existan) ---
# AUTH_DB_URL=jdbc:postgresql://localhost:5432/auth
# AUTH_DB_USER=auth
# AUTH_DB_PASSWORD=auth

# USER_DB_URL=jdbc:postgresql://localhost:5433/users
# USER_DB_USER=users
# USER_DB_PASSWORD=users

# --- JWT (mismo valor en servicios que validan token: user, report) ---
# Generar ejemplo:  openssl rand -base64 48
JWT_SECRET=example_replace_with_long_random_secret_min_256_bits_for_hs256________________
JWT_EXPIRATION_MS=86400000

# --- MinIO (S3 local; credenciales solo en tu .env) ---
MINIO_ROOT_USER=example_minio_access_key
MINIO_ROOT_PASSWORD=example_replace_minio_secret

# --- Desarrollo local (perfil dev, H2 / IDE) ---
# DB_USERNAME=admin
# DB_PASSWORD=example_dev_db_password

# --- URLs entre microservicios (local / Docker) ---
# USER_SERVICE_URL=http://localhost:8081
# AUTH_SERVICE_URL=http://localhost:8081
# SANOS_USER_SERVICE_URL=http://localhost:8081
# SANOS_PET_SERVICE_URL=http://localhost:8083
# SANOS_REPORT_SERVICE_URL=http://localhost:8082
