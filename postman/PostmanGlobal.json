        {
          "name": "Auth — POST /api/v1/auth/login (ejecutar PRIMERO)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  var j = pm.response.json();",
                  "  if (j.token) { pm.collectionVariables.set('token', j.token); }",
                  "  if (j.userId) { pm.collectionVariables.set('userId', j.userId); }",
                  "  pm.test('Login OK: token y userId guardados en la colección', function () {",
                  "    pm.expect(j.token).to.be.a('string');",
                  "    pm.expect(j.userId).to.exist;",
                  "  });",
                  "} else {",
                  "  pm.test('Login falló: ' + pm.response.code, function () { pm.expect.fail(); });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@test.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
